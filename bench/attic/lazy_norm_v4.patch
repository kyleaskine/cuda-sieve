+/* --lazy-norm: a floor Tlo <= T(x) for all 32 cells x = xbase + 32g + 0..31
+ * of one group, which lie in one row at i0 .. i0+31. The lazy init leaves
+ * every cell at its bare sieved sum v, so CINIT - Tlo + v >= CINIT - T + v
+ * (the exact cell) and a threshold test against the floor is a SUPERSET test;
+ * only the cells that pass it pay for T. Survivors are identical exactly when
+ * Tlo <= T, and nothing else here has to be right: the correction writes
+ * CINIT - T + v, which does not involve Tlo at all.
+ *
+ * The floor is the mean value theorem on F_f, the normalised form evaluated in
+ * real arithmetic with the float parameters (d[], ua..vb). Along the row, u and
+ * v move by ua and va per cell, so with the centre c = i0 + 15.5 and h = 15.5,
+ *     |F_f(i)| >= |F_f(c)| - h * max|dF_f/di|   over i0 .. i0+31.
+ * Every |u| on the group is at most Ua = |ua|(|c| + h) + |ub| j -- the
+ * ABSOLUTE sum, which cancellation in u cannot shrink -- and likewise Va, both
+ * padded by 2^-20 relative for their own rounding. With P the
+ * absolute-coefficient form, max|dF_f/di| <= |ua| dP/dU + |va| dP/dV at
+ * (Ua, Va).
+ *
+ * Three rounding gaps separate that from what the device writes: the fp32
+ * centre value against F_f(c), the per-cell fp32 path against F_f(i), and the
+ * fp64 fallback against F_f(i) (it uses the double parameters). Each is below
+ * (8*deg + 1) * 2^-24 * P(Ua, Va) -- 2^-17.9 of it at deg 8: the Horner's own
+ * error is 2*deg ulps of P(|u|,|v|) <= P(Ua,Va); an error of 2^-23 Ua in u
+ * (its fmaf, or the rounding of ua and ub) moves F by at most 2^-23 Ua dP/dU,
+ * and Ua dP/dU + Va dP/dV = deg * P(Ua,Va) by Euler's identity for a
+ * homogeneous form; the d[] rounding adds 2^-24 P. The slack is 2^-14 P(Ua,Va),
+ * about 5x their sum. It is LOCAL: an absolute slack (2^-14 sum|d_k|, the
+ * first version) zeroed the floor on 3.9% of c183's cells, every row whose
+ * norms sit far below the form's maximum. The -1 on the rounded value covers
+ * log2f's ulp and the fp32 mul/add after it (both monotone under
+ * round-to-nearest), and a floor that comes out <= 0 -- a root of F_f inside
+ * the group -- is Tlo = 0, which is always sound.
+ *
+ * LAZY_NORM_CHECK builds compute both for EVERY cell and count Tlo > T. */
+__device__ __forceinline__ uint32_t norm_group_floor(const norm_t &N, int32_t i0,
+                                                     uint32_t jj, uint32_t TMAX)
+{
+    const float h   = 15.5f;
+    const float pad = 1.0f + 0x1p-20f;
+    const float fc  = __fadd_rn((float)i0, 15.5f);     /* exact: |i0| < 2^20 */
+    const float fj  = (float)jj;
+    const float uc  = __fmaf_rn(N.ua, fc, __fmul_rn(N.ub, fj));
+    const float vc  = __fmaf_rn(N.va, fc, __fmul_rn(N.vb, fj));
+    const float ai  = __fadd_rn(fabsf(fc), h);
+    const float U   = __fmul_rn(__fmaf_rn(fabsf(N.ua), ai, __fmul_rn(fabsf(N.ub), fj)), pad);
+    const float V   = __fmul_rn(__fmaf_rn(fabsf(N.va), ai, __fmul_rn(fabsf(N.vb), fj)), pad);
+
+    /* descending k: F_f(c), and P with dP/dU by Horner-in-U */
+    float acc = N.d[N.deg], vp = 1.0f;
+    float p = fabsf(N.d[N.deg]), pu = 0.0f, Vp = 1.0f;
+    #pragma unroll
+    for (int k = BENCH_MAX_DEGREE - 1; k >= 0; k--)
+        if (k < N.deg) {
+            vp  = __fmul_rn(vp, vc);
+            acc = __fmaf_rn(acc, uc, __fmul_rn(N.d[k], vp));
+            Vp  = __fmul_rn(Vp, V);
+            pu  = __fmaf_rn(pu, U, p);
+            p   = __fmaf_rn(p, U, __fmul_rn(fabsf(N.d[k]), Vp));
+        }
+    /* ascending k: dP/dV by Horner-in-V */
+    float q = fabsf(N.d[0]), qv = 0.0f, Up = 1.0f;
+    #pragma unroll
+    for (int k = 1; k <= BENCH_MAX_DEGREE; k++)
+        if (k <= N.deg) {
+            Up = __fmul_rn(Up, U);
+            qv = __fmaf_rn(qv, V, q);
+            q  = __fmaf_rn(q, V, __fmul_rn(fabsf(N.d[k]), Up));
+        }
+    const float D    = __fmaf_rn(fabsf(N.ua), pu, __fmul_rn(fabsf(N.va), qv));
+    const float loss = __fmul_rn(__fmaf_rn(h, D, __fmul_rn(0x1p-14f, p)),
+                                 1.0f + 0x1p-10f);
+    const float slo  = __fsub_rn(fabsf(acc), loss);
+    if (!(slo > 0.0f)) return 0u;
+    const float lg = __fmul_rn(N.scale,
+        __fsub_rn(__fadd_rn(N.log2M, log2f(fmaxf(slo, 1e-30f))), N.bias));
+    const int ti = (int)floorf(__fadd_rn(lg, 0.5f)) - 1;
+    return (ti < 0) ? 0u : ((uint32_t)ti > TMAX ? TMAX : (uint32_t)ti);
+}
