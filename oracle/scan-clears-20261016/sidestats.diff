+/* TEST-ONLY (work/scan-i16/stat, never landed): per-side acceptance. */
+__global__ void k_side_stats(const uint8_t *__restrict st0, const uint8_t *__restrict st1,
+                             uint32_t n, unsigned long long *__restrict out)
+{
+    unsigned long long a0 = 0, a1 = 0, b = 0;
+    for (uint64_t t = bench_grid_thread_x(); t < n; t += bench_grid_stride_x()) {
+        const int x0 = (st0[t] == COF_ACCEPT || st0[t] == COF_SPLIT);
+        const int x1 = (st1[t] == COF_ACCEPT || st1[t] == COF_SPLIT);
+        a0 += x0; a1 += x1; b += x0 & x1;
+    }
+    if (a0) atomicAdd(&out[0], a0);
+    if (a1) atomicAdd(&out[1], a1);
+    if (b)  atomicAdd(&out[2], b);
+}
+static unsigned long long g_ss_tot[4];
+static void side_stats_print(void)
+{
+    printf("  [sidestats] two-sided %llu | side 1 accept %llu (%.2f%%) | side 0 accept %llu (%.2f%%) | both %llu (%.3f%%)\n",
+           g_ss_tot[3], g_ss_tot[1], 100.0 * g_ss_tot[1] / g_ss_tot[3],
+           g_ss_tot[0], 100.0 * g_ss_tot[0] / g_ss_tot[3], g_ss_tot[2], 100.0 * g_ss_tot[2] / g_ss_tot[3]);
+}
