+/* --tiny-table: build tables A and B (SS_TAB_WORDS words at T) for this
+ * region. Entries [e0, e0 + ntab) are the tabled ones; word t < 45 of A gets
+ * the hits of m in {3, 5, 9} on cells CPW*t + c, word t of B (T[45 + t]) those
+ * of m == 7 on cells CPW*t + c. Per-row setup is ss_setup, so the position set
+ * is the walk's: a cell X is hit iff X % mm == c0 (c0 < mm), and init's word w
+ * reads A[w % 45], B[w % 7] (see SS_TAB_A_WORDS). The first warps build it,
+ * one word per lane; every word is written, so nothing needs clearing. Lane k
+ * sets up entry base+k and the warp reads them by shuffle. The caller's
+ * barrier publishes the tables before init reads them. */
+template <int CELLBITS>
+__device__ __forceinline__ void ss_table_build(uint32_t *T,
+                                               const uint32_t *__restrict sp,
+                                               const uint32_t *__restrict srt,
+                                               const uint32_t *__restrict sg,
+                                               const uint16_t *__restrict slp,
+                                               const uint32_t *__restrict smag,
+                                               uint32_t e0, uint32_t ntab,
+                                               uint32_t j, int32_t ilo, int logI,
+                                               int evenrow, uint32_t tid,
+                                               uint32_t nth)
+{
+    const uint32_t CPW = 32 / CELLBITS;
+    const uint32_t kshift = SS_KSHIFT(logI);
+    const uint32_t lane = tid & 31u;
+    for (uint32_t wb = tid & ~31u; wb < SS_TAB_WORDS; wb += nth) {
+        const uint32_t t = wb + lane;
+        const bool inA = t < SS_TAB_A_WORDS;
+        const uint32_t tc = CPW * (inA ? t : t - SS_TAB_A_WORDS);
+        uint32_t word = 0;
+        for (uint32_t base = 0; base < ntab; base += 32u) {
+            uint32_t pk = 0;
+            if (base + lane < ntab) {
+                const uint32_t e = e0 + base + lane;
+                uint32_t mm;
+                const uint32_t c0 = ss_setup(e, sp, srt, sg, smag, j, ilo, kshift,
+                                             evenrow, &mm);
+                /* c0 < mm <= 18: 8 bits each; bit 15 marks table B (m == 7) */
+                if (mm) pk = c0 | (mm << 8) | ((uint32_t)(sp[e] == 7u) << 15) |
+                             ((uint32_t)slp[e] << 16);
+            }
+            const uint32_t ne = (ntab - base < 32u) ? ntab - base : 32u;
+            for (uint32_t k = 0; k < ne; k++) {
+                const uint32_t q  = __shfl_sync(0xFFFFFFFFu, pk, k);
+                const uint32_t mm = (q >> 8) & 0x7Fu;
+                if (!mm || ((q >> 15) & 1u) == (uint32_t)inA) continue;
+                const uint32_t c0 = q & 0xFFu;
+                #pragma unroll
