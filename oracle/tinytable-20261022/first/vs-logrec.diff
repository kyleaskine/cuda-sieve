+/* ss_setup for a folded entry, without its general machinery: every folded m
+ * is a power of two (m == 1 included), so the first hit is the AND that
+ * ss_first's own power-of-two branch takes -- exact even if the 32-bit sum
+ * wraps, since m divides 2^32 -- with no reciprocal load and no 64-bit
+ * fallback (ss_first's for m == 1, whose reciprocal is 0). For m >= 2 the row
+ * divisor is a power of two too (q = 2^k), so g's test is a mask; m == 1 has
+ * g = q, any prime power. The even-row rule is ss_setup's. The log is loaded
+ * with the other three words, one round trip (finding 129's review). Returns
+ * the packed (c0, mm, lp) the fold's shuffle reads, 0 for no hits this row. */
+__device__ __forceinline__ uint32_t ss_fold_setup(uint32_t e,
+                                                  const uint32_t *__restrict sp,
+                                                  const uint32_t *__restrict srt,
+                                                  const uint32_t *__restrict sg,
+                                                  const uint16_t *__restrict slp,
+                                                  uint32_t j, int32_t ilo,
+                                                  uint32_t kshift, int evenrow)
+{
+    const uint32_t m = sp[e], g = sg[e], rt = srt[e], lp = slp[e];
+    uint32_t jj = j;
+    if (g > 1) {
+        if (!(g & (g - 1u))) {
