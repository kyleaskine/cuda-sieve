+/* ---- RECSCAN: test-only counters for the side-0 record scan. Never landed.
+ * Per side, after its apply: the bucket records written (the cursor sum, so
+ * overflowed appends included), the fullest region, and how many regions
+ * hold more than cap/2. Single-queued only (buckets still hold side 0's
+ * records at TD): side 0's records on two-sided survivors, counted per
+ * survivor and compared with the side-0 resieve's pcnt[0]. */
+typedef struct {
+    unsigned long long recs[2], maxreg[2], over_half[2], nreg[2];
+    unsigned long long on_surv, n_surv, pcnt_sum, mismatch, more, fewer, over_k;
+} rs_ctr_t;
+static rs_ctr_t *g_rs_ctr = NULL;
+static uint32_t *g_rs_rcnt = NULL, g_rs_rcap = 0, g_rs_cap = 0;
+static const uint32_t *g_rs_bucket = NULL, *g_rs_cursor = NULL;
+static int g_rs_scan = 0;
+static unsigned long long g_rs_nslab = 0;
+static double g_rs_ms_scan = 0, g_rs_ms_rs0 = 0, g_rs_ms_rs1 = 0;
+static cudaEvent_t g_rs_ev[2];
+
+__global__ void k_rs_cursor_stats(const uint32_t *__restrict cursor, uint32_t nregion,
+                                  uint32_t cap, rs_ctr_t *c, int side)
+{
+    unsigned long long sum = 0, over = 0; uint32_t mx = 0;
+    for (uint64_t i = bench_grid_thread_x(); i < nregion; i += bench_grid_stride_x()) {
+        const uint32_t v = cursor[i];
+        sum += v; mx = max(mx, v); over += (v > cap / 2u);
+    }
+    if (sum) atomicAdd(&c->recs[side], sum);
+    if (over) atomicAdd(&c->over_half[side], over);
+    if (mx) atomicMax(&c->maxreg[side], (unsigned long long)mx);
+    if (bench_grid_thread_x() == 0) atomicAdd(&c->nreg[side], (unsigned long long)nregion);
+}
+
+__global__ void k_rs_scan(const uint32_t *__restrict bucket, const uint32_t *__restrict cursor,
+                          uint32_t cap, int log_region, const uint32_t *__restrict two,
+                          const uint32_t *__restrict gbase, uint32_t *__restrict rcnt, rs_ctr_t *c)
+{
+    const uint32_t b = blockIdx.x, offmask = (1u << log_region) - 1u;
+    uint32_t m = cursor[b]; if (m > cap) m = cap;
+    unsigned long long hit = 0;
+    for (uint32_t k = threadIdx.x; k < m; k += blockDim.x) {
+        const uint32_t x = (b << log_region) | (bucket[(size_t)b * cap + k] & offmask);
+        if ((two[x >> 5] >> (x & 31u)) & 1u) { atomicAdd(&rcnt[td_rank(two, gbase, x)], 1u); hit++; }
+    }
+    if (hit) atomicAdd(&c->on_surv, hit);
+}
+
+__global__ void k_rs_compare(const uint32_t *__restrict rcnt, const uint32_t *__restrict pcnt,
+                             uint32_t n, uint32_t K, rs_ctr_t *c)
+{
+    unsigned long long ps = 0, mis = 0, more = 0, fewer = 0, ok = 0, ns = 0;
+    for (uint64_t i = bench_grid_thread_x(); i < n; i += bench_grid_stride_x()) {
+        const uint32_t r = rcnt[i], q = pcnt[i];
+        ps += q; ns++; mis += (r != q); more += (r > q) ? r - q : 0; fewer += (r < q) ? q - r : 0;
+        ok += (q > K);
+    }
+    if (ns) atomicAdd(&c->n_surv, ns);
+    if (ps) atomicAdd(&c->pcnt_sum, ps);
+    if (mis) atomicAdd(&c->mismatch, mis);
+    if (more) atomicAdd(&c->more, more);
+    if (fewer) atomicAdd(&c->fewer, fewer);
+    if (ok) atomicAdd(&c->over_k, ok);
+}
